# Committed defaults. inkspire_api/settings.py takes the INKSPIRE_-prefixed keys and
# lorebook/layout.py takes LOREBOOK_ROOT; each ignores the other's. Per-machine values
# and anything secret go in .env.local, which is not committed and wins over this file.
# A real environment variable wins over both.

# INKSPIRE_JWT_SECRET has no default, so the server refuses to start without one.
# Generate it into .env.local:
#   python -c 'import secrets; print(secrets.token_hex(32))'
# INKSPIRE_JWT_SECRET=

INKSPIRE_DATABASE_URL=sqlite:///var/data_dev.db
INKSPIRE_JWT_TTL=3600
INKSPIRE_REFRESH_TOKEN_TTL=604800

# The story repository, which lives outside this project. Set the real path in
# .env.local; there is no sensible default for another machine.
# INKSPIRE_DATA_ROOT=~/Documents/novel-data

# Everything that is not a novel: notes, and the folders they sit in. Inside this
# project, not committed, and created when something is first written to it. The
# default is where it belongs, so this rarely needs setting.
INKSPIRE_FILES_ROOT=var/files

# Providers live in config/providers.yaml, which is not committed because it holds
# API keys. See the README.
#
# Reasoning: false tells a model not to think, true tells it to, and leaving this
# unset sends nothing and lets the model decide. Thinking delays the first chunk by
# the whole reasoning pass, and a model with a small context window can spend all of
# it thinking and never answer — raise INKSPIRE_LLM_NUM_CTX or turn thinking off.
# INKSPIRE_LLM_THINK=false
# INKSPIRE_LLM_NUM_CTX=10240

# The longest acceptable gap between two streamed chunks, in seconds. A whole
# generation may take far longer; only silence ends it.
INKSPIRE_LLM_TIMEOUT=120

# The directory holding one lorebook per subdirectory, read by the `lorebook` command.
# It is the `stories/` directory of the story repository above, so it is per-machine
# too: set it in .env.local. With nothing set, every lorebook command fails rather than
# guessing a directory.
# LOREBOOK_ROOT=~/Documents/novel-data/stories

# Who a commit from the git routes is from. Left unset, the story repository's own
# `git config` is used instead — its own config, then global, then system — exactly
# as committing there by hand would.
# INKSPIRE_GIT_AUTHOR_NAME=
# INKSPIRE_GIT_AUTHOR_EMAIL=

# How long a single git command may run before it is killed. A push or a pull talks
# to the remote and can hang.
INKSPIRE_GIT_TIMEOUT=60
