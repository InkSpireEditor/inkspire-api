[BASIC]
variable-rgx=(([a-z][a-zA-Z0-9]{2,30})|(_[a-zA-Z0-9]*))$
argument-rgx=(([a-z][a-zA-Z0-9]{2,30})|(_[a-zA-Z0-9]*))$
attr-rgx=(([a-z][a-zA-Z0-9]{2,30})|(_[a-zA-Z0-9]*))$
function-rgx=(test_(\d+)_)?[a-z]+((\d)|([A-Z0-9][a-z0-9]+))*([A-Z])?$
method-rgx=(([a-z][a-zA-Z0-9]{2,30})|(_[a-zA-Z0-9]*)|(__[a-zA-Z0-9]{2,30}__))$
const-rgx=(([A-Z_][A-Z0-9_]*)|(__.*__))$

# Good variable names which should always be accepted, separated by a comma
good-names=i,j,k,n,e,me

# Bad variable names which should always be refused, separated by a comma
bad-names=foo,bar,baz,toto,tutu,tata

# Minimum number of public methods for a class (see R0903).
min-public-methods=0

# Maximum number of arguments for function / method
max-args=12

# Maximum number of local variables. prompt.py's assemble() and llm.py's stream()
# each gain one more with every later prompt section (api#17 et seq.) -- the
# intended extension pattern per docs/prompt.md, not a one-off.
max-locals=18

# Maximum number of attributes for a class (see R0902).
max-attributes=20

# Maximum number of public methods for a class (see R0904). storage.Scanner gained
# write_context_summary (api#18) alongside the write_document it pairs with.
max-public-methods=21

# Maximum number of lines in a module (see C0302). cli.py gains one CLI command per
# generation-adjacent route -- `llm summary` (api#18) is the latest -- and each is a
# handful of lines, not a reason to split the file.
max-module-lines=1100

[MESSAGES CONTROL]
disable=C0301,W0603,W1203,C0103,C1803,R1705,R1720
